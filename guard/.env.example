# Copy to .env.local. Keep credentials local; never paste tokens into a chat.
TELEGRAM_BOT_TOKEN=
# Set by the one-time, code-bound pairing command. Do not guess these IDs.
TELEGRAM_OWNER_ID=
TELEGRAM_CHAT_ID=
# The guard reads an existing Gemini key from the environment or web/.env.local.
# GEMINI_API_KEY=
GRAVEYARD_GEMINI_MODEL=gemini-3.6-flash
GRAVEYARD_GEMINI_MAX_ATTEMPTS=1
GRAVEYARD_GEMINI_TIMEOUT_MS=12000
GRAVEYARD_REPLY_WAIT_S=120
GRAVEYARD_VOICE=off
IMESSAGE_TO=
