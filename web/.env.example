# Copy to .env.local and enter secrets locally. Never commit real keys.
# Offline checks and the default scripted smoke task do not need credentials.
GEMINI_API_KEY=
# GOOGLE_API_KEY is a supported alternative; use only one key setting.
# GOOGLE_API_KEY=

# Optional model overrides. Use one model ID listed for your API key.
# Blank model settings should be omitted, not uncommented.
# GEMINI_JUDGE_MODEL=
# LIVE_JUDGE_MODEL=
# GEMINI_VOICE_MODEL=
# GEMINI_TTS_MODEL=

# Optional Gemini cache and request spacing (not a total spending limit).
# GEMINI_CACHE_DIR=data/cache/gemini
GEMINI_MIN_INTERVAL_MS=0

# Optional Claude browser agent; outside the Gemini/scripted baseline.
# ANTHROPIC_API_KEY=
# CLAUDE_AGENT_MODEL=
CLAUDE_TOKEN_BUDGET=150000

# Optional phone reply links. These do not establish notification delivery.
# PUBLIC_CALL_BASE=http://localhost:3222
CALL_PORT=3222
# Leave IMESSAGE_TO unset: setting it enables real outgoing notifications.
# IMESSAGE_TO=
